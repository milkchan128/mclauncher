<div id="landingContainer" style="display: none;">
    <nav id="landingRail" aria-label="<%- lang('landing.railLabel') %>">
        <button class="railItem" id="railHome" type="button" aria-label="<%- lang('landing.railHome') %>">
            <svg class="railIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-7 9 7M5 10v10h14V10"/></svg>
            <span class="railTip"><%- lang('landing.railHome') %></span>
        </button>
        <button class="railItem" id="newsButton" type="button" aria-label="<%- lang('landing.newsButton') %>">
            <svg class="railIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h8M8 17h5"/></svg>
            <span id="newsButtonAlert" style="display: none;"></span>
            <span class="railTip"><%- lang('landing.newsButton') %></span>
        </button>
        <button class="railItem" id="railMods" type="button" aria-label="<%- lang('landing.railMods') %>">
            <svg class="railIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10"/></svg>
            <span class="railTip"><%- lang('landing.railMods') %></span>
        </button>
        <div class="railSpacer"></div>
        <button class="railItem" id="avatarOverlay" type="button" aria-label="<%- lang('landing.usernameEditButton') %>">
            <span id="avatarContainer"></span>
            <span class="railTip" id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
        </button>
        <button class="railItem" id="settingsMediaButton" type="button" aria-label="<%- lang('landing.settingsTooltip') %>">
            <svg class="railIcon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9L7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1"/></svg>
            <span class="railTip"><%- lang('landing.settingsTooltip') %></span>
        </button>
    </nav>
    <main id="landingStage">
        <div id="landingScenery" aria-hidden="true">
            <div class="sceneryLayer" id="sceneryBack"></div>
            <div class="sceneryLayer" id="sceneryMid"></div>
            <div class="sceneryLayer" id="sceneryFront"></div>
        </div>
        <button id="landingNotice" type="button" disabled>
            <svg class="noticeIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
            <span class="noticeLabel"><%- lang('landing.noticeLabel') %></span>
            <span class="noticeDivider" aria-hidden="true"></span>
            <span id="landingNoticeTitle"><%- lang('landing.newsErrorLoadSpan') %></span>
            <span class="noticeGo"><%- lang('landing.noticeGo') %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </button>
        <section id="landingBand">
            <div id="landingTrack">
                <div id="landingCart">
                    <div id="cartBubble" role="status" aria-live="polite"><span id="cartBubbleText"></span><span id="cartBubblePercent"></span></div>
                    <div id="landingPet" hidden></div>
                    <svg id="cartSvg" viewBox="0 -7 19 18" aria-hidden="true">
                        <circle class="cartGlow" cx="16.5" cy="3" r="2.5"/>
                        <g class="steveBody" shape-rendering="crispEdges">
                            <rect x="6" y="-2" width="4" height="3" fill="#2f9c9c"/>
                            <g class="steveHead">
                                <g class="steveFace">
                                    <rect x="6" y="-6" width="4" height="4" fill="#c69c7a"/>
                                    <rect x="6" y="-6" width="4" height="1" fill="#3b2a1d"/>
                                    <rect x="6" y="-5" width="1" height="2" fill="#3b2a1d"/>
                                    <rect x="8" y="-4" width="1" height="1" fill="#ffffff"/>
                                    <rect x="9" y="-4" width="1" height="1" fill="#4b3fa6"/>
                                    <rect x="8" y="-3" width="1" height="1" fill="#7a4a35"/>
                                </g>
                            </g>
                        </g>
                        <g shape-rendering="crispEdges">
                            <rect x="0" y="1" width="16" height="1" fill="#a39cb3"/>
                            <rect x="1" y="2" width="14" height="6" fill="#6c667b"/>
                            <rect x="1" y="5" width="14" height="1" fill="#565067"/>
                            <rect x="5" y="2" width="1" height="6" fill="#5d576d"/>
                            <rect x="10" y="2" width="1" height="6" fill="#5d576d"/>
                            <rect x="16" y="2" width="1" height="2" fill="#ffd38a"/>
                        </g>
                        <g class="steveBody" shape-rendering="crispEdges">
                            <g class="steveArm">
                                <rect x="9" y="0" width="3" height="1" fill="#2f9c9c"/>
                                <rect x="12" y="0" width="1" height="1" fill="#c69c7a"/>
                                <g class="steveApple"><rect x="12.5" y="-0.5" width="1.5" height="1.5" fill="#d7332e"/><rect x="13" y="-1" width="0.5" height="0.5" fill="#5b3a1e"/></g>
                            </g>
                        </g>
                        <g class="cartWheel"><circle cx="4" cy="9" r="1.8"/><path d="M2.2 9h3.6M4 7.2v3.6"/></g>
                        <g class="cartWheel"><circle cx="12" cy="9" r="1.8"/><path d="M10.2 9h3.6M12 7.2v3.6"/></g>
                    </svg>
                </div>
                <!-- 스티브를 누르면 이 중 하나가 랜덤으로 와서 카트를 따라 달린다. -->
                <template id="petWolf">
                    <svg viewBox="-1 -1 14 8" aria-hidden="true" shape-rendering="crispEdges" fill="#c9c4bf">
                        <rect x="0" y="1.5" width="2" height="1"/>
                        <rect x="2" y="2" width="7" height="3" fill="#d8d4d0"/>
                        <rect x="2" y="2" width="7" height="1" fill="#b8b2ad"/>
                        <rect x="8" y="0" width="3" height="3" fill="#d8d4d0"/>
                        <rect x="8" y="-1" width="1" height="1"/>
                        <rect x="10" y="-1" width="1" height="1"/>
                        <rect x="11" y="1" width="1.5" height="1.5" fill="#d8d4d0"/>
                        <rect x="12" y="1" width="0.6" height="0.6" fill="#2b2324"/>
                        <rect x="10" y="0.6" width="0.6" height="0.6" fill="#2b2324"/>
                        <rect x="8" y="2" width="0.8" height="2" fill="#d23a3a"/>
                    <g class="petLegs petLegsA"><rect x="3" y="5" width="1" height="2"/><rect x="7" y="5" width="1" height="2"/></g>
                    <g class="petLegs petLegsB"><rect x="4" y="5" width="1" height="2"/><rect x="6" y="5" width="1" height="2"/></g>
                    </svg>
                </template>
                <template id="petFox">
                    <svg viewBox="-1 -1 14 8" aria-hidden="true" shape-rendering="crispEdges" fill="#2b2324">
                        <rect x="-1" y="1" width="3" height="2" fill="#e0803a"/>
                        <rect x="-1" y="1" width="1" height="2" fill="#f2e8dc"/>
                        <rect x="2" y="2" width="6.5" height="3" fill="#e0803a"/>
                        <rect x="3" y="4" width="4" height="1" fill="#f2e8dc"/>
                        <rect x="8" y="0" width="3" height="3" fill="#e0803a"/>
                        <rect x="8" y="-1" width="1" height="1" fill="#e0803a"/>
                        <rect x="10" y="-1" width="1" height="1" fill="#e0803a"/>
                        <rect x="9" y="2" width="2" height="1" fill="#f2e8dc"/>
                        <rect x="11" y="1.5" width="1.5" height="1.5" fill="#f2e8dc"/>
                        <rect x="12.2" y="1.5" width="0.6" height="0.6"/>
                        <rect x="10" y="0.8" width="0.6" height="0.6"/>
                    <g class="petLegs petLegsA"><rect x="3" y="5" width="1" height="2"/><rect x="7" y="5" width="1" height="2"/></g>
                    <g class="petLegs petLegsB"><rect x="4" y="5" width="1" height="2"/><rect x="6" y="5" width="1" height="2"/></g>
                    </svg>
                </template>
                <template id="petCat">
                    <svg viewBox="-1 -1 14 8" aria-hidden="true" shape-rendering="crispEdges" fill="#1f1c24">
                        <rect x="0" y="1" width="1" height="3" fill="#2a2730"/>
                        <rect x="1" y="3" width="1" height="1" fill="#2a2730"/>
                        <rect x="2" y="3" width="7" height="2" fill="#2a2730"/>
                        <rect x="8" y="0.5" width="3.5" height="3" fill="#2a2730"/>
                        <rect x="8" y="-0.5" width="1" height="1" fill="#2a2730"/>
                        <rect x="10.5" y="-0.5" width="1" height="1" fill="#2a2730"/>
                        <rect x="10.5" y="1.5" width="0.7" height="0.7" fill="#e8d44d"/>
                        <rect x="11.5" y="2.3" width="0.5" height="0.5" fill="#e88aa0"/>
                    <g class="petLegs petLegsA"><rect x="3" y="5" width="1" height="2"/><rect x="7" y="5" width="1" height="2"/></g>
                    <g class="petLegs petLegsB"><rect x="4" y="5" width="1" height="2"/><rect x="6" y="5" width="1" height="2"/></g>
                    </svg>
                </template>
            </div>
            <div id="landingServer">
                <div id="image_seal_container">
                    <img id="image_seal" src="assets/images/servers/society-sunlit-valley.png" alt="Society: Sunlit Valley 로고"/>
                    <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
                </div>
                <div id="landingServerText">
                    <h1 id="landingServerName"><%- lang('landing.serverNamePlaceholder') %></h1>
                    <p id="landingServerMeta">
                        <span id="player_count" role="status"><%- lang('landing.serverStatusPlaceholder') %></span><span class="metaDot" aria-hidden="true">·</span><span id="landingServerVersion"></span>
                    </p>
                </div>
            </div>
            <div id="launch_content">
                <button id="server_selection_button" type="button" aria-haspopup="listbox" aria-expanded="false"><%- lang('landing.serverButton') %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
                <button id="console_button" type="button" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7l5 5-5 5M12 17h7"/></svg><%- lang('landing.consoleButton') %></button>
                <button id="launch_button" type="button" title="<%= lang('landing.launchButtonHint') %>"><span class="launchStart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5l13 7.5-13 7.5z"/></svg><%- lang('landing.launchButton') %></span><span class="launchStop"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5"/></svg><%- lang('landing.launchStopButton') %></span></button>
                <div id="serverFlyout" role="listbox" aria-label="<%- lang('landing.serverButton') %>" hidden></div>
            </div>
        </section>
        <div id="newsContainer">
            <div id="newsContent" article="-1" style="display: none;">
                <div id="newsStatusContainer">
                    <div id="newsStatusContent">
                        <div id="newsTitleContainer">
                            <a id="newsArticleTitle" href="#">Lorem Ipsum</a>
                        </div>
                        <div id="newsMetaContainer">
                            <div id="newsArticleDateWrapper">
                                <span id="newsArticleDate">Mar 15, 44 BC, 9:14 AM</span>
                            </div>
                            <div id="newsArticleAuthorWrapper">
                                <span id="newsArticleAuthor">by Cicero</span>
                            </div>
                            <a href="#" id="newsArticleComments">0 Comments</a>
                        </div>
                    </div>
                    <div id="newsNavigationContainer">
                        <button id="newsNavigateLeft">
                            <svg id="newsNavigationLeftSVG" viewBox="0 0 24.87 13.97">
                                <defs>
                                    <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                                </defs>
                                <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                            </svg>
                        </button>
                        <span id="newsNavigationStatus"><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                        <button id="newsNavigateRight">
                            <svg id="newsNavigationRightSVG" viewBox="0 0 24.87 13.97">
                                <defs>
                                    <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                                </defs>
                                <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div id="newsArticleContainer">
                    <div id="newsArticleContent">
                        <div id="newsArticleContentScrollable">
                            <!-- Article Content -->
                        </div>
                    </div>
                </div>
            </div>
            <div id="newsErrorContainer">
                <div id="newsErrorLoading">
                    <span id="nELoadSpan" class="newsErrorContent"><%- lang('landing.newsErrorLoadSpan') %></span>
                </div>
                <div id="newsErrorFailed" style="display: none;">
                    <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                    <button id="newsErrorRetry"><%- lang('landing.newsErrorRetryButton') %></button>
                </div>
                <div id="newsErrorNone" style="display: none;">
                    <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
                </div>
            </div>
        </div>
    </main>
    <dialog id="consoleDialog" aria-labelledby="consoleTitle">
        <div id="consoleHeader">
            <h2 id="consoleTitle"><%- lang('landing.consoleTitle') %></h2>
            <button id="consoleClose" type="button" aria-label="<%= lang('landing.consoleClose') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <pre id="consoleOutput" tabindex="0"></pre>
    </dialog>
    <script src="./assets/js/scripts/landing.js"></script>
</div>
