<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mlkc Client 설치" Width="860" Height="552" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI, 맑은 고딕" FontSize="14">
  <Window.Resources>
    <!-- 런처 메인 화면(launcher.css의 landing 색 변수)과 같은 색 -->
    <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#A7A3B0"/>
    <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Field" Color="#2B2930"/>
    <SolidColorBrush x:Key="Line" Color="#17FFFFFF"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
              <Border x:Name="ButtonSurface" CornerRadius="6" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Border x:Name="ButtonHover" CornerRadius="6" Background="#1FFFFFFF" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ButtonHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ButtonHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="White"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Windows 11 창 버튼 -->
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CaptionSurface" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#14FFFFFF"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#14FFFFFF"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#C42B1C"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="FieldSurface" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FieldSurface" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
              <Border x:Name="Pulse" Width="120" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3">
                <Border.RenderTransform><TranslateTransform X="-120"/></Border.RenderTransform>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-120" To="420" Duration="0:0:1.4">
                      <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#5A5563" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="CheckSurface" Width="20" Height="20" CornerRadius="5" BorderBrush="#8A8496" BorderThickness="1" Background="{StaticResource Field}" VerticalAlignment="Center">
              <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 14,4" Stroke="Black" StrokeThickness="1.9" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="White"/><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="ChoiceSurface" Padding="16,15" CornerRadius="8" Background="#0AFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="ChoiceRing" Width="17" Height="17" Stroke="#8A8496" StrokeThickness="1" VerticalAlignment="Center"/>
              <Ellipse x:Name="ChoiceDot" Width="9" Height="9" Fill="{StaticResource Accent}" Visibility="Collapsed" VerticalAlignment="Center"/>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="#12FFFFFF"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="ChoiceSurface" Property="Background" Value="#1A60CDFF"/><Setter TargetName="ChoiceRing" Property="Stroke" Value="{StaticResource Accent}"/><Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Viewbox Stretch="Uniform">
  <Border Width="860" Height="552" CornerRadius="8" Background="#181422" BorderBrush="#2E2840" BorderThickness="1">
    <Grid>
      <Grid.Clip><RectangleGeometry Rect="0,0,858,550" RadiusX="7" RadiusY="7"/></Grid.Clip>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image x:Name="BrandLogo" Width="16" Height="16" Margin="0,0,10,0"/>
          <TextBlock Text="mlkc Client 설치" Foreground="{StaticResource Ink}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Text="·" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="MinimizeButton" Style="{StaticResource Caption}" AutomationProperties.Name="최소화">
            <Path Data="M 0,5 L 10,5" Stroke="White" StrokeThickness="1" Width="10" Height="10"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CloseCaption}" AutomationProperties.Name="닫기">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1" Width="10" Height="10"/>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Margin="8,0,0,8" CornerRadius="8" BorderBrush="#12FFFFFF" BorderThickness="1">
        <Border.Background><ImageBrush x:Name="SceneBrush" Stretch="UniformToFill" AlignmentX="Center"/></Border.Background>
        <Border x:Name="BrandBand" VerticalAlignment="Bottom" CornerRadius="0,0,7,7" Background="#E0201F24" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="20,16">
          <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
          <StackPanel Orientation="Horizontal">
            <Image x:Name="BandLogo" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="밀튜디오" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="society-sunlit.vultr.sjh.kr" Foreground="#D0CDD8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <Grid x:Name="PageContent" Grid.Row="1" Grid.Column="1" Margin="36,24,36,24">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="Heading" Text="설치 안내" Foreground="{StaticResource Ink}" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,15"/>
          <TextBlock x:Name="Description" Text="클라이언트를 설치한 뒤,&#x0a;첫 실행에서 모드팩을 준비합니다." Foreground="{StaticResource Muted}" FontSize="15" LineHeight="25"/>
        </StackPanel>
        <StackPanel x:Name="LicensePanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
          <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <ScrollViewer Height="149" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="클라이언트 사용권 계약">
              <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="#D0CDD8" Margin="0,0,8,0"/>
            </ScrollViewer>
          </Border>
          <TextBlock FontSize="11" Margin="0,9,0,10"><Hyperlink x:Name="MinecraftEula" Foreground="{StaticResource Accent}">Minecraft 공식 EULA 보기</Hyperlink></TextBlock>
          <CheckBox x:Name="AcceptLicense" AutomationProperties.Name="사용권 계약 동의">
            <TextBlock Text="위 사용권 계약을 읽었으며 동의합니다." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Ink}"/>
          </CheckBox>
        </StackPanel>
        <StackPanel x:Name="ScopePanel" Grid.Row="1" Margin="0,28,0,0" Visibility="Collapsed">
          <RadioButton x:Name="CurrentUser" GroupName="InstallScope" IsChecked="True" AutomationProperties.Name="현재 사용자에게만 설치">
            <StackPanel><TextBlock Text="현재 사용자" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="이 Windows 계정에서 사용합니다." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="AllUsers" GroupName="InstallScope" Margin="0,12,0,0" AutomationProperties.Name="모든 사용자에게 설치">
            <StackPanel><TextBlock Text="모든 사용자" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="이 PC의 모든 계정에서 사용합니다.&#x0a;설치할 때 관리자 권한이 필요합니다." FontSize="12" LineHeight="20" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel x:Name="LocationPanel" Grid.Row="1" Margin="0,32,0,0" Visibility="Collapsed">
          <Label Content="설치 위치" Target="{Binding ElementName=InstallPath}" Foreground="{StaticResource Ink}" Padding="0" Margin="0,0,0,9"/>
          <TextBox x:Name="InstallPath" FontSize="12" HorizontalScrollBarVisibility="Hidden" AutomationProperties.Name="설치 위치"/>
          <TextBlock Text="원하면 설치 경로를 직접 바꿀 수 있어요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,16,0,12">
          <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#1FFFFFFF" Visibility="Collapsed" BorderThickness="0"/>
          <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="이전" Width="78" Height="44" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="InstallButton" Grid.Column="1" Content="다음" Height="44" Background="{StaticResource Accent}" BorderBrush="Transparent" Foreground="Black" FontSize="15" FontWeight="SemiBold" IsDefault="True"/>
          </Grid>
          <Button x:Name="FinishCloseButton" Content="닫기" Margin="0,8,0,0" Visibility="Collapsed" Height="36" Background="Transparent" BorderBrush="Transparent"/>
          <TextBlock Text="첫 실행에는 인터넷 연결이 필요합니다." HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
  </Viewbox>
</Window>
