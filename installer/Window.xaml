<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mlkc Client 설치" Width="860" Height="552" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, 맑은 고딕" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#241E30"/>
    <SolidColorBrush x:Key="Muted" Color="#71697E"/>
    <SolidColorBrush x:Key="Accent" Color="#BFA2F5"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.6"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#EEEAF3"/>
      <Setter Property="BorderBrush" Value="#DED7E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True" Background="{TemplateBinding Background}">
              <Border x:Name="Pulse" Width="110" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2">
                <Border.RenderTransform><TranslateTransform X="-110"/></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-110" To="400" Duration="0:0:1.3"/>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#C8BED6" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="CheckSurface" Width="20" Height="20" CornerRadius="5" BorderBrush="#BDB2CE" BorderThickness="1" Background="White" VerticalAlignment="Center">
              <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 14,4" Stroke="White" StrokeThickness="1.7" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource Ink}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="ChoiceSurface" Padding="16,15" CornerRadius="10" Background="#EEEAF3" BorderBrush="#DED7E8" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="17" Height="17" Stroke="#AEA1BF" StrokeThickness="1" VerticalAlignment="Center"/>
              <Ellipse x:Name="ChoiceDot" Width="9" Height="9" Fill="{StaticResource Ink}" Visibility="Collapsed" VerticalAlignment="Center"/>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="ChoiceSurface" Property="Background" Value="#EAE0F8"/><Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Viewbox Stretch="Uniform">
  <Border Width="860" Height="552" CornerRadius="18" Background="#F7F5FA" BorderBrush="#D9D3E1" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border CornerRadius="18,0,0,18">
        <Border.Background><ImageBrush x:Name="SceneBrush" Stretch="UniformToFill" AlignmentX="Left"/></Border.Background>
        <Border CornerRadius="18,0,0,18">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#35201A2C" Offset="0"/><GradientStop Color="#D91C1726" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid Margin="30,30,30,38">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
              <Image x:Name="BrandLogo" Width="30" Height="30" Margin="0,0,10,0"/>
              <TextBlock Text="mlkc Client" Foreground="White" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="밀튜디오&#x0a;클라이언트" Foreground="#FCFAFF" FontSize="35" LineHeight="48" FontWeight="SemiBold" Margin="0,0,0,20"/>
              <TextBlock Text="Society: Sunlit Valley" Foreground="#E1D9EA" FontSize="15"/>
              <TextBlock Text="mc.mlkc.kr" Foreground="#CDB9EE" FontSize="14" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
      <Grid x:Name="TitleBar" Grid.Column="1" Height="58" VerticalAlignment="Top" Background="Transparent" Margin="18,0,12,0">
        <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="18,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="MinimizeButton" Width="44" Height="40" VerticalAlignment="Center" AutomationProperties.Name="최소화">
            <Path Data="M 0,5 L 11,5" Stroke="#71697E" StrokeThickness="1.5" Width="12" Height="12"/>
          </Button>
          <Button x:Name="CloseButton" Width="44" Height="40" VerticalAlignment="Center" AutomationProperties.Name="닫기">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#71697E" StrokeThickness="1.5" Width="12" Height="12"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid x:Name="PageContent" Grid.Column="1" Margin="36,80,36,26">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="Heading" Text="설치 안내" Foreground="{StaticResource Ink}" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,15"/>
          <TextBlock x:Name="Description" Text="클라이언트를 설치한 뒤,&#x0a;첫 실행에서 모드팩을 준비합니다." Foreground="{StaticResource Muted}" FontSize="15" LineHeight="25"/>
        </StackPanel>
        <StackPanel x:Name="LicensePanel" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
          <Border Background="#EEEAF3" CornerRadius="9" Padding="12">
            <ScrollViewer Height="149" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="클라이언트 사용권 계약">
              <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource Ink}" Margin="0,0,8,0"/>
            </ScrollViewer>
          </Border>
          <TextBlock FontSize="11" Margin="0,9,0,10"><Hyperlink x:Name="MinecraftEula" Foreground="#7252A7">Minecraft 공식 EULA 보기</Hyperlink></TextBlock>
          <CheckBox x:Name="AcceptLicense" AutomationProperties.Name="사용권 계약 동의">
            <TextBlock Text="위 사용권 계약을 읽었으며 동의합니다." TextWrapping="Wrap" FontSize="12"/>
          </CheckBox>
        </StackPanel>
        <StackPanel x:Name="ScopePanel" Grid.Row="1" Margin="0,28,0,0" Visibility="Collapsed">
          <RadioButton x:Name="CurrentUser" GroupName="InstallScope" IsChecked="True" AutomationProperties.Name="현재 사용자에게만 설치">
            <StackPanel><TextBlock Text="현재 사용자" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="이 Windows 계정에서 사용합니다." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="AllUsers" GroupName="InstallScope" Margin="0,12,0,0" AutomationProperties.Name="모든 사용자에게 설치">
            <StackPanel><TextBlock Text="모든 사용자" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="이 PC의 모든 계정에서 사용합니다.&#x0a;설치할 때 관리자 권한이 필요합니다." FontSize="12" LineHeight="20" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel x:Name="LocationPanel" Grid.Row="1" Margin="0,32,0,0" Visibility="Collapsed">
          <Label Content="설치 위치" Target="{Binding ElementName=InstallPath}" Foreground="{StaticResource Ink}" Padding="0" Margin="0,0,0,9"/>
          <TextBox x:Name="InstallPath" FontSize="12" HorizontalScrollBarVisibility="Hidden" AutomationProperties.Name="설치 위치"/>
          <TextBlock Text="원하면 설치 경로를 직접 바꿀 수 있어요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,16,0,12">
          <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#E8E2F0" Visibility="Collapsed" BorderThickness="0"/>
          <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="이전" Width="78" Height="50" Margin="0,0,12,0" Background="#EAE5F0" Visibility="Collapsed"/>
            <Button x:Name="InstallButton" Grid.Column="1" Content="다음" Height="50" Background="{StaticResource Ink}" Foreground="White" FontSize="15" FontWeight="SemiBold" IsDefault="True"/>
          </Grid>
          <Button x:Name="FinishCloseButton" Content="닫기" Margin="0,8,0,0" Visibility="Collapsed" Height="36"/>
          <TextBlock Text="첫 실행에는 인터넷 연결이 필요합니다." HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
  </Viewbox>
</Window>
